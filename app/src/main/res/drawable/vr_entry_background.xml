<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#41596B" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#253442" />
            <stroke android:width="2dp" android:color="#8EEBD3" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#182331" />
            <stroke android:width="1dp" android:color="#587084" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
